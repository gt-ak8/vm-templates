# Git identity seeded into the VM by bootstrap.sh (never committed).
# Copy to .env in this directory and fill in before running create.sh.
GIT_USER_NAME="Jane Doe"
GIT_USER_EMAIL="jane@example.com"
# Public SSH key used for commit signing (the private key stays on the host,
# reached via the forwarded ssh-agent).
GIT_SIGNING_PUBKEY="ssh-ed25519 AAAA... jane@example.com"
