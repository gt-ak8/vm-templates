# Copy to microsandbox/.env and fill in. This file is gitignored.
# A GitHub token with `admin:public_key` and `admin:ssh_signing_key` scopes.
# `admin:` on the signing scope, not `write:`: deleting the key at destroy needs it.
GH_TOKEN=ghp_replace_me
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Optional. A Claude Code OAuth token from `claude setup-token`, not an API key.
# The guest only ever sees a placeholder; the value is substituted by the
# sandbox proxy on requests to api.anthropic.com. Leave it out to fall back to
# the credentials in the bind-mounted ~/.claude.
CLAUDE_CODE_OAUTH_TOKEN=
