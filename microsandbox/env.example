# Copy to microsandbox/.env and fill in. This file is gitignored.
#
# Two GitHub tokens, deliberately: the authority to add and remove SSH keys on
# your account stays on the host, and only the narrow one is injected into the
# VM. The links below pre-tick the right scopes. Set an expiry on both, and if
# your org enforces SSO, hit "Configure SSO" then "Authorize" after creating
# each one or the calls come back 404.

# Host-side only. Registers and removes the sandbox key; never enters the VM.
# Needs `admin:public_key` and `admin:ssh_signing_key`. `admin:` on the signing
# scope, not `write:`: deleting the key at destroy needs it.
# https://github.com/settings/tokens/new?description=wbox%20host%20admin&scopes=admin:public_key,admin:ssh_signing_key
GH_ADMIN_TOKEN=ghp_replace_me

# Injected into the VM for the gh CLI. Give it only what an agent needs there,
# typically `repo` and `read:org`, and none of the key-admin scopes above.
# https://github.com/settings/tokens/new?description=wbox%20sandbox&scopes=repo,read:org
GH_TOKEN=ghp_replace_me

GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Optional. A Claude Code OAuth token from `claude setup-token`, not an API key.
# The guest only ever sees a placeholder; the value is substituted by the
# sandbox proxy on requests to api.anthropic.com. Setting it also shadows the
# host credentials in the shared ~/.claude with an empty file, so this is the
# only Claude credential in the VM. Leave it out to fall back to those shared
# credentials instead.
CLAUDE_CODE_OAUTH_TOKEN=
