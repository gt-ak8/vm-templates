# Copy to microsandbox/.env and fill in. This file is gitignored.
#
# Two GitHub tokens, deliberately: the authority to add and remove SSH keys on
# your account stays on the host, and only the narrow one is injected into the
# VM. The links below pre-tick the right scopes. Set an expiry on both, and if
# your org enforces SSO, hit "Configure SSO" then "Authorize" after creating
# each one or the calls come back 404. That authorization is what lets git in
# the sandbox reach SSO-enforced org repos: SSH keys would each need their own
# authorization through the web UI, which no API can do.

# Host-side only. Registers and removes the sandbox signing key; never enters
# the VM. Needs `admin:ssh_signing_key`. `admin:`, not `write:`: deleting the
# key at destroy needs it.
# https://github.com/settings/tokens/new?description=wbox%20host%20admin&scopes=admin:ssh_signing_key
GH_ADMIN_TOKEN=ghp_replace_me

# Injected into the VM for the gh CLI *and* for git itself: fetch, pull, push
# and clone all go over HTTPS with this token, so it is the credential your org
# sees. `workflow` is in the list because a push touching .github/workflows is
# rejected without it. None of the key-admin scopes above.
# https://github.com/settings/tokens/new?description=wbox%20sandbox&scopes=repo,read:org,workflow
GH_TOKEN=ghp_replace_me

GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Optional. A Claude Code OAuth token from `claude setup-token`, not an API key.
# The guest only ever sees a placeholder; the value is substituted by the
# sandbox proxy on requests to api.anthropic.com. Setting it also binds an empty
# file over ~/.claude/.credentials.json in the VM, so this is the only Claude
# credential there. Leave it out and the sandbox has to log in itself.
CLAUDE_CODE_OAUTH_TOKEN=
